[Unit]
Description=Crescent Yuri Forum
After=network.target

[Service]
Type=simple
User=coder
WorkingDirectory=/var/www/yaoguang-forum
ExecStart=/usr/bin/node /var/www/yaoguang-forum/server.js
Restart=on-failure
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
